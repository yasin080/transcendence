# Environment — never commit real credentials
.env
.env.local
.env.*.local

# Backend (Laravel)
/backend/vendor/
/backend/storage/*.key
/backend/storage/framework/cache/*
/backend/storage/framework/sessions/*
/backend/storage/framework/views/*
/backend/storage/logs/*
/backend/public/storage
/backend/.phpunit.result.cache

# Frontend (React + Vite)
/frontend/node_modules/
/frontend/dist/
/frontend/.vite/
/frontend/*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# TLS certificates generated at runtime
/docker/nginx/certs/

/diario.md

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp

# Database dumps made by the backup service
/backups/*
!/backups/.gitkeep
