#!/bin/sh
# Build the frontend before committing: the same two steps `npm run build`
# runs (type-check + Vite bundle), so anything that would break the build
# blocks the commit. The bundle goes to a throwaway dir, never to dist/.
# Skip in an emergency with: git commit --no-verify

# Only run when the commit touches the frontend
git diff --cached --name-only --diff-filter=ACMRD | grep -q '^frontend/' || exit 0

ROOT=$(git rev-parse --show-toplevel)
compose() { docker compose -f "$ROOT/compose.yaml" "$@"; }
CHECK='tsc --noEmit -p . && vite build --logLevel error --outDir "$OUT" --emptyOutDir'

echo "pre-commit: building frontend..."

# Prefer the container: its node_modules volume is what the app really runs on.
# The host's frontend/node_modules (if any) is a separate install and may be stale.
if compose ps --status running --services 2>/dev/null | grep -qx frontend; then
	compose exec -T frontend sh -c "export PATH=\"./node_modules/.bin:\$PATH\" OUT=/tmp/precommit-dist && $CHECK"
elif [ -x "$ROOT/frontend/node_modules/.bin/tsc" ]; then
	echo "pre-commit: frontend container not running, using the host's node_modules."
	OUT=$(mktemp -d)
	(cd "$ROOT/frontend" && export PATH="./node_modules/.bin:$PATH" OUT && eval "$CHECK")
	status=$?
	rm -rf "$OUT"
	(exit $status)
else
	echo "pre-commit: frontend container not running and no local node_modules ('make up' first). Skipping."
	exit 0
fi

status=$?
if [ $status -ne 0 ]; then
	echo ""
	echo "pre-commit: frontend build failed, commit aborted."
	echo "            Fix it or use 'git commit --no-verify' to skip."
fi
exit $status
