# ---------------------------------------------------------------------------
# Copy this file to .env and adjust the values. Never commit .env.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Host user — keeps files created inside the containers owned by you.
# Find yours with: id -u  /  id -g
UID=1000
GID=1000

# --- Application -----------------------------------------------------------
APP_NAME=Transcendence
APP_ENV=local
APP_DEBUG=true
APP_URL=https://localhost

# --- Database (MariaDB) ----------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=transcendence
DB_USERNAME=transcendence
DB_PASSWORD=replace_with_your_own_password
DB_ROOT_PASSWORD=replace_with_another_password

# --- Redis -----------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_CLIENT=phpredis

# --- Laravel drivers -------------------------------------------------------
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:1443
BROADCAST_CONNECTION=reverb

# --- Google OAuth (Socialite) -----------------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# and add the redirect URI below as an authorized redirect URI.
GOOGLE_CLIENT_ID=replace_with_your_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_your_google_client_secret
GOOGLE_REDIRECT_URI=https://localhost:443/auth/google/callback

# --- Reverb (WebSocket server) ---------------------------------------------
# APP_ID/KEY/SECRET identify the app to Reverb. Change them for your team.
REVERB_APP_ID=transcendence
REVERB_APP_KEY=replace_with_a_random_key
REVERB_APP_SECRET=replace_with_a_random_secret
# Where Laravel publishes events: the reverb container, inside the Docker
# network. The browser does not use these; it connects through nginx.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# What the Reverb process itself binds to inside its container.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# --- Frontend (exposed to the browser — never put secrets here) -------------
# Values are literal, not interpolated: keep them in sync with the ones above.
VITE_APP_NAME=Transcendence
VITE_REVERB_APP_KEY=replace_with_a_random_key

# --- nginx -----------------------------------------------------------------
# dev  -> proxies / to the Vite dev server (hot reload)
# prod -> serves the static build from frontend/dist
# `make` / `make up` set prod and `make dev` sets dev; this value only
# applies to a bare `docker compose up`.
NGINX_MODE=dev

# Ports published on the host. If you change HTTPS_PORT, add localhost:<port>
# to SANCTUM_STATEFUL_DOMAINS (Sanctum matches host and port together).
HTTP_PORT=8080
HTTPS_PORT=1443

# Cuentas creadas por el seeder (si falta algún dato, esa cuenta no se crea)
SEED_USER1_USERNAME=
SEED_USER1_EMAIL=
SEED_USER1_PASSWORD=
SEED_USER2_USERNAME=
SEED_USER2_EMAIL=
SEED_USER2_PASSWORD=
